<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>assets\roadsense-app.ico</ApplicationIcon>
    <Version>0.8.0</Version>
    <Description>A Windows arcade driving game about spotting and safely handling simulated road hazards.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Update="settings.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="concept\roadsense-tax-poster-prototype.png" />
    <EmbeddedResource Include="assets\roadsense-logo.png" />
    <EmbeddedResource Include="assets\major-pothole.png" />
    <EmbeddedResource Include="assets\roadsense-app.ico" />
    <EmbeddedResource Include="assets\crash.wav" />
    <EmbeddedResource Include="assets\crash-2.wav" />
    <EmbeddedResource Include="assets\crash-3.wav" />
    <EmbeddedResource Include="assets\crash-scene-frames.zip" />
    <EmbeddedResource Include="assets\crash-scene-2-frames.zip" />
    <EmbeddedResource Include="assets\crash-scene-3-frames.zip" />
    <EmbeddedResource Include="assets\car-selection-reference.png" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

</Project>
